{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["sep", "title", "status", "type", "authors", "requires"],
  "additionalProperties": false,
  "properties": {
    "sep": {"type": ["integer", "null"], "minimum": 0},
    "title": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["Draft", "Accepted", "Rejected", "Superseded"]},
    "type": {"const": "Standards Track"},
    "authors": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "requires": {"type": "array", "items": {"type": "integer"}}
  }
}
